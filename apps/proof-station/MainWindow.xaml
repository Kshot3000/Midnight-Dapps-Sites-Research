<Window x:Class="MidnightProofStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Midnight Proof Station" Width="1170" Height="910" MinWidth="855" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#0D0E17" Foreground="#F3F1FF"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#171927"/>
    <SolidColorBrush x:Key="CardFill" Color="#10121E"/>
    <SolidColorBrush x:Key="Line" Color="#363951"/>
    <SolidColorBrush x:Key="Muted" Color="#BDC0D6"/>
    <SolidColorBrush x:Key="Accent" Color="#D0BFFF"/>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="37"/>
      <Setter Property="Margin" Value="0,0,7,6"/>
      <Setter Property="Background" Value="#25283B"/>
      <Setter Property="Foreground" Value="#F3F1FF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBox" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBox" Property="BorderBrush" Value="#E6DCFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBox" Property="BorderBrush" Value="White"/>
                <Setter TargetName="ButtonBox" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBox" Property="Opacity" Value=".48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#161024"/>
      <Setter Property="BorderBrush" Value="#D0BFFF"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10121E"/>
      <Setter Property="Foreground" Value="#F3F1FF"/>
      <Setter Property="CaretBrush" Value="#F3F1FF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#10121E"/>
      <Setter Property="Foreground" Value="#F3F1FF"/>
      <Setter Property="CaretBrush" Value="#F3F1FF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,23,28,20">
      <DockPanel Margin="0,0,0,19">
        <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="12" BorderBrush="#63517E"
                BorderThickness="1" Padding="11,5" Margin="10,6,0,0">
          <TextBlock Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                     Text="PREVIEW TESTNET"/>
        </Border>
        <StackPanel>
          <TextBlock Text="Midnight Proof Station" FontSize="37" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                     Text="Run a local Midnight full node and generate zero-knowledge test proofs on your NVIDIA GPU."/>
        </StackPanel>
      </DockPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.17*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="Preview services" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="EngineStatus" Style="{StaticResource Secondary}" Text="Docker status not checked" Margin="0,2,0,11"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Full node · 2.1.101" FontWeight="SemiBold"/>
                <TextBlock x:Name="NodeStatus" Text="Status not checked" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="NodeDetail" Text="RPC · 127.0.0.1:9944" Style="{StaticResource Secondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Indexer · 4.4.101" FontWeight="SemiBold"/>
                <TextBlock x:Name="IndexerStatus" Text="Status not checked" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="IndexerDetail" Text="GraphQL · 127.0.0.1:8088" Style="{StaticResource Secondary}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Wallet proof server · 9.0.2" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProofServerStatus" Text="Status not checked" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ProofServerDetail" Text="Lace local CPU prover · 127.0.0.1:6300" Style="{StaticResource Secondary}"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Cardano Preview db-sync" FontWeight="SemiBold" Margin="0,6,0,3"/>
            <TextBlock Text="The full node needs a synced database over TLS. The wallet prover can start on its own."
                       Style="{StaticResource Secondary}" Margin="0,0,0,7"/>
            <PasswordBox x:Name="DatabaseUrl" AutomationProperties.Name="Cardano Preview db-sync PostgreSQL connection URI"
                         ToolTip="Paste the PostgreSQL connection URI for your synced Cardano Preview db-sync."/>
            <DockPanel Margin="0,7,0,7">
              <Button DockPanel.Dock="Left" Content="Select CA certificate" Click="SelectCa_Click"
                      ToolTip="Optional PEM certificate for verifying the database server" />
              <TextBlock x:Name="CaLabel" Style="{StaticResource Secondary}" Text="Optional database CA"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel>
              <Button x:Name="StartPreview" Style="{StaticResource Primary}" Content="Start Preview stack" Click="StartPreview_Click"/>
              <Button x:Name="StartWallet" Content="Start wallet prover" Click="StartWallet_Click"/>
              <Button x:Name="StopStack" Content="Stop services" Click="StopStack_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="CUDA proof lab" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,11"
                       Text="Experimental local proofs from Charles Hoskinson’s draft. Uses a synthetic circuit and a stock verifier."/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="NVIDIA device" FontWeight="SemiBold"/>
                <TextBlock x:Name="GpuStatus" Text="GPU not checked" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="GpuDetail" Text="CUDA through your default WSL2 distribution" Style="{StaticResource Secondary}"/>
                <DockPanel Margin="0,8,0,0">
                  <TextBlock DockPanel.Dock="Left" Text="Device index" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBox x:Name="DeviceIndex" Width="55" HorizontalAlignment="Left" Text="0" MaxLength="3"
                           TextChanged="DeviceIndex_Changed" AutomationProperties.Name="NVIDIA device index"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Last proof job" FontWeight="SemiBold"/>
                <TextBlock x:Name="GpuResult" Text="No proof job run" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="GpuResultDetail" Style="{StaticResource Secondary}"
                           Text="The result shows completed CUDA calls, proof verification and fallbacks."/>
              </StackPanel>
            </Border>
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="CheckGpu" Content="Detect GPU" Click="CheckGpu_Click"/>
              <Button x:Name="BuildCuda" Content="Build CUDA backend" Click="BuildCuda_Click"/>
              <Button x:Name="GenerateProofs" Style="{StaticResource Primary}" Content="Generate sample proofs" Click="GenerateProofs_Click"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                       Text="The stock wallet prover handles Preview transactions. CUDA jobs stay in the lab until the draft supports the released wallet proving API."/>
          </StackPanel>
        </Border>
      </Grid>

      <DockPanel Margin="0,15,0,4">
        <Button x:Name="RefreshStatus" DockPanel.Dock="Right" Content="Refresh status" Click="Refresh_Click" Margin="0"/>
        <TextBlock Text="Activity" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox x:Name="ActivityLog" Height="87" IsReadOnly="True" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
               AutomationProperties.Name="Local activity log" Text="Start a service or detect a GPU to see activity here."/>
      <TextBlock x:Name="Message" Text="Waiting for an action." Style="{StaticResource Secondary}" Margin="0,9,0,9"
                 AutomationProperties.LiveSetting="Polite"/>

      <Expander Header="Support the project" Foreground="#F3F1FF" Margin="0,3,0,0">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Independent builder — not affiliated with the Midnight Foundation or IOG." Style="{StaticResource Secondary}"/>
          <TextBlock Margin="0,4,0,8">
            Built by Kyle Cox · <Hyperlink Click="Profile_Click" Foreground="{StaticResource Accent}">@kshot9000</Hyperlink>
          </TextBlock>
          <TextBlock Text="Cardano donation address" FontWeight="SemiBold"/>
          <TextBox x:Name="AdaAddress" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                   AutomationProperties.Name="Cardano donation address"
                   Text="addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v"/>
          <Button Content="Copy Cardano address" Click="CopyAda_Click" HorizontalAlignment="Left" Margin="0,5,0,8"/>
          <TextBlock Text="Midnight shielded donation address" FontWeight="SemiBold"/>
          <TextBox x:Name="MidnightAddress" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                   AutomationProperties.Name="Midnight shielded donation address"
                   Text="mn_shield-addr1k5vrk8kh4cj9l6cetlumrjy3w0l9p5tt9mux4mnn2pxn6ck70hlrxasc88v202l8w0c4ne5r03du7s4pxawd6r54a2sw0rgnq253lgsdksa2q"/>
          <Button Content="Copy Midnight address" Click="CopyMidnight_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
