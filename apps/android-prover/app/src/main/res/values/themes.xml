<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window, no action bar, transparent system bars: no white flash before Compose draws. -->
    <style name="Theme.MidnightProver" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/abyss</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme for androidx core-splashscreen: Midnight icon on the abyss background. -->
    <style name="Theme.MidnightProver.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/abyss</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MidnightProver</item>
    </style>
</resources>
